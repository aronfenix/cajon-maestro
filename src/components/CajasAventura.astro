---
// Las aventuras como cajas cerradas con su tapa ilustrada (portada y páginas de área).
import { Image } from 'astro:assets';
import type { Aventura } from '../lib/catalogo';
import { cajaDe } from '../lib/cajas';
interface Props { cajas: Aventura[] }
const { cajas } = Astro.props;
---

<ul class="aventuras-lista">
  {cajas.map((a) => (
    <li>
      <a class="aventura" href={a.mapa.url} style={`--area: ${a.mapa.tema.area.color}`}>
        <span class="caja caja-grande">
          <span class="miniatura forma-juego tapa">
            {cajaDe(a.mapa.id) ? (
              <img class="color" src={cajaDe(a.mapa.id)!.tapa} alt="" loading="lazy" />
            ) : (
              a.mapa.portada && <Image class="color" src={a.mapa.portada} alt="" widths={[480, 960]} sizes="(max-width: 860px) 92vw, 480px" />
            )}
            <span class="precinto">{a.juegos.length} juegos</span>
            {Date.now() - a.mapa.fecha.getTime() < 21 * 864e5 && <span class="sello-nueva">Nueva</span>}
          </span>
        </span>
        <span class="aventura-texto">
          <span class="subrayado" style={`background: ${a.mapa.tema.area.color}`}>{a.mapa.tema.area.nombre}</span>
          <span class="aventura-titulo">{a.mapa.titulo}</span>
          <span class="material-meta">{a.zonas.length} zonas: {a.zonas.map((z) => z.nombre).join(', ')}.</span>
        </span>
      </a>
    </li>
  ))}
</ul>
