---
import { Image, getImage } from 'astro:assets';
import Archivador from '../../layouts/Archivador.astro';
import Miniatura from '../../components/Miniatura.astro';
import Buzon from '../../components/Buzon.astro';
import { catalogo, relacionadosDe, aventuraDe, render, detalle, type Material } from '../../lib/catalogo';
import { TIPOS } from '../../data/areas';
import { SITIO } from '../../data/sitio';
import { ruta } from '../../lib/rutas';
import { cajaDe } from '../../lib/cajas';

export async function getStaticPaths() {
  const { materiales } = await catalogo();
  return materiales.map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props as { m: Material };
const { Content } = await render(m.entrada);
const tieneCuerpo = m.entrada.body?.trim().length;
const aventura = await aventuraDe(m);
const relacionados = aventura ? [] : await relacionadosDe(m);
const { materiales } = await catalogo();
const caja = aventura ? cajaDe(m.id) : undefined;
const madre = m.aventura ? materiales.find((x) => x.id === m.aventura) : undefined;
const tipo = TIPOS[m.tipo];
const det = detalle(m);
const og = m.portada ? (await getImage({ src: m.portada, width: 1200, format: 'jpg' })).src : undefined;
const poster = m.portada && m.video ? (await getImage({ src: m.portada, width: 1280, format: 'webp' })).src : undefined;

// El botón principal depende de lo que haya.
let principal: { href: string; texto: string; descarga?: boolean } | undefined;
let secundario: { href: string; texto: string; descarga?: boolean } | undefined;
if (m.lector?.length) {
  principal = { href: ruta(`/materiales/${m.id}/leer/`), texto: 'Leer el cómic' };
  if (m.archivo) secundario = { href: m.archivo, texto: 'Descargar (PDF)', descarga: true };
} else if (m.archivo) {
  const ext = m.archivo.split('.').pop()?.toUpperCase();
  const extra = [ext, det].filter(Boolean).join(', ');
  principal = { href: m.archivo, texto: `Descargar${extra ? ` (${extra})` : ''}`, descarga: true };
} else if (m.enlace) {
  principal = { href: m.enlace, texto: tipo.accion };
}
const descargaVideo = m.video ? { href: m.video, texto: 'Descargar el vídeo (MP4)' } : undefined;
---

<Archivador activo={m.tema.area.id} titulo={m.titulo} descripcion={m.resumen} imagen={og}>
  <p class="miga">
    <a href={ruta('/')}>{SITIO.nombre}</a> / <a href={ruta(`/${m.tema.area.id}/`)}>{m.tema.area.nombre}</a> / {m.tema.titulo}
  </p>

  <div class="portada-material">
    <div>
      <h1 class={m.titulo.length > 22 ? "rotulo largo" : "rotulo"}>{m.titulo}</h1>
      <p class="entradilla">{m.resumen}</p>
      <div class="botones">
        {principal && (
          <a class="boton" href={principal.href} download={principal.descarga ? '' : undefined}>
            {principal.texto}
          </a>
        )}
        {secundario && (
          <a class="boton-sec" href={secundario.href} download={secundario.descarga ? '' : undefined}>
            {secundario.texto}
          </a>
        )}
        {descargaVideo && (
          <a class={principal ? 'boton-sec' : 'boton'} href={descargaVideo.href} download="">
            {descargaVideo.texto}
          </a>
        )}
        {m.codigo && (
          <a class="boton-sec" href={m.codigo}>
            Ver el código en GitHub
          </a>
        )}
      </div>
      {m.pendiente && <p class="aviso-pendiente">Falta subir el archivo: todavía no hay nada que descargar.</p>}
    </div>

    {caja ? (
      <figure class="caja3d-marco" aria-label={`La caja de ${m.titulo}`}>
        <div class="caja3d">
          <img class="cara tapa3d" src={caja.tapa} alt={`Tapa de la caja de ${m.titulo}`} />
          <img class="cara lomo3d-largo" src={caja.lomoLargo} alt="" />
          <img class="cara lomo3d-corto" src={caja.lomoCorto} alt="" />
        </div>
      </figure>
    ) : (
    <figure class="captura">
      {
        m.video ? (
          <video controls preload="none" poster={poster} src={m.video}>
            <a href={m.video}>Descargar el vídeo</a>
          </video>
        ) : m.portada ? (
          <Image src={m.portada} alt={`Portada de ${m.titulo}`} widths={[640, 1000, 1400]} sizes="(max-width: 860px) 92vw, 620px" style={`view-transition-name: m-${m.id}`} />
        ) : (
          <div class="sin-portada">Sin portada todavía</div>
        )
      }
    </figure>
    )}
  </div>

      {
        aventura && (
          <section class="zonas-dentro" aria-labelledby="dentro" data-aventura>
            <h2 class="seccion-titulo" id="dentro">Lo que hay dentro</h2>
            <p class="progreso-tablet" data-progreso hidden />
            {caja && (
              <div class="caja-abierta" style={`--interior: url('${caja.interior}')`}>
                {aventura.zonas.slice(0, 6).map((z, i) => (
                  <a class="compartimento" href={`#zona-${i + 1}`} style={`--c:${i % 3};--f:${Math.floor(i / 3)}`}>
                    <span class="compartimento-juegos" aria-hidden="true">
                      {z.juegos.slice(0, 4).map((j, k) => j.portada && (
                        <Image src={j.portada} alt="" widths={[200]} sizes="140px" style={`--k:${k};--t:${Math.min(z.juegos.length, 4)}`} />
                      ))}
                    </span>
                    <span class="compartimento-nombre">{z.nombre}</span>
                    <span class="compartimento-cuenta">{z.juegos.length === 1 ? '1 juego' : `${z.juegos.length} juegos`}</span>
                  </a>
                ))}
                <img class="tapa-suelta" src={caja.tapa} alt="" aria-hidden="true" />
              </div>
            )}
            {aventura.zonas.map((z, i) => (
              <div class="zona" id={`zona-${i + 1}`} style={`--zona: ${z.color ?? '#000'}`}>
                <h3 class="zona-titulo"><span class="zona-num">{i + 1}</span>{z.nombre}</h3>
                <ul class="zona-lista">
                  {z.juegos.map((j) => (
                    <li>
                      <a class="zona-juego" href={j.url} data-juego={j.enlace}>
                        <Miniatura material={j} ancho={200} />
                        <span class="material-titulo">{j.titulo}</span>
                        <span class="hecho" hidden>Hecho en esta tablet</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            {aventura.final && (
              <div class="zona zona-final">
                <h3 class="zona-titulo"><span class="zona-num">★</span>Y al final</h3>
                <ul class="zona-lista">
                  <li>
                    <a class="zona-juego" href={aventura.final.url} data-juego={aventura.final.enlace}>
                      <Miniatura material={aventura.final} ancho={200} />
                      <span class="material-titulo">{aventura.final.titulo}</span>
                      <span class="hecho" hidden>Hecho en esta tablet</span>
                    </a>
                  </li>
                </ul>
              </div>
            )}
          </section>
        )
      }
  <div class="cuerpo">
    <dl class="datos">
      {m.tema.curso && (<><dt>Curso</dt><dd>{m.tema.curso}</dd></>)}
      <dt>Área</dt>
      <dd>
        <span class="subrayado" style={`background: ${m.tema.area.color}`}>{m.tema.area.nombre}</span>
        <br />{m.tema.titulo}
      </dd>
      <dt>Tipo</dt>
      <dd>{tipo.nombre}{det && `, ${det}`}</dd>
      {m.ia && (<><dt>Con IA</dt><dd>{m.ia}</dd></>)}
      <dt>Licencia</dt>
      <dd><a href={SITIO.licencia.url} rel="license">{SITIO.licencia.nombre}</a></dd>
    </dl>

    <div class="texto">
      {
        tieneCuerpo && (
          <section class="bloque" aria-labelledby="uso">
            <h2 class="seccion-titulo" id="uso">Cómo lo uso en clase</h2>
            <div class="prosa"><Content /></div>
          </section>
        )
      }
      {
        m.cambiaria && (
          <section class="bloque" aria-labelledby="cambiaria">
            <h2 class="seccion-titulo" id="cambiaria">Lo que cambiaría</h2>
            <p class="prosa boli-rojo">{m.cambiaria}</p>
          </section>
        )
      }
      {
        madre && (
          <p class="de-aventura">
            Forma parte de la aventura <a href={madre.url}>{madre.titulo}</a>. Se puede jugar suelto.
          </p>
        )
      }
      {
        relacionados.length > 0 && (
          <section class="bloque" aria-labelledby="vacon">
            <h2 class="seccion-titulo" id="vacon">Va con</h2>
            <ul class="fila va-con">
              {relacionados.map((r) => (
                <li>
                  <a class={`material ancho-${r.tipo}`} href={r.url}>
                    <Miniatura material={r} />
                    <p class="material-titulo">{r.titulo}</p>
                    <p class="material-meta">{r.resumen}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <Buzon
        material={m.titulo}
        titulo={['juego', 'web', 'herramienta'].includes(m.tipo) ? '¿Algo no funciona?' : '¿Algo está mal?'}
      />
    </div>
  </div>
</Archivador>

<script>
  // Solo se lee lo que ya guardó este aparato al jugar: aquí no se manda nada a ningún sitio.
  const caja = document.querySelector<HTMLElement>('[data-aventura]');
  if (caja) {
    const juegos = [...caja.querySelectorAll<HTMLAnchorElement>('[data-juego]')];
    let hechos = 0;
    for (const a of juegos) {
      let ok = false;
      try {
        ok = !!localStorage.getItem('cajon-hecho:' + new URL(a.dataset.juego!, location.href).pathname);
      } catch {}
      if (ok) {
        hechos++;
        a.classList.add('esta-hecho');
        a.querySelector<HTMLElement>('.hecho')!.hidden = false;
      }
    }
    const p = caja.querySelector<HTMLElement>('[data-progreso]')!;
    if (hechos) {
      p.textContent = `En esta tablet llevas ${hechos} de ${juegos.length}.`;
      p.hidden = false;
    }
  }
</script>
