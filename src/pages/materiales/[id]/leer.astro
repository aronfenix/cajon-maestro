---
import '@fontsource-variable/big-shoulders-stencil';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '../../../styles/global.css';
import { catalogo, type Material } from '../../../lib/catalogo';
import { SITIO } from '../../../data/sitio';
import { ruta } from '../../../lib/rutas';

export async function getStaticPaths() {
  const { materiales } = await catalogo();
  return materiales.filter((m) => m.lector?.length).map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props as { m: Material };
const paginas = m.lector!;
const total = paginas.length;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`Leer: ${m.titulo} · ${SITIO.nombre}`}</title>
    <meta name="description" content={m.resumen} />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="lector">
    <header class="lector-barra">
      <a class="lector-volver" href={m.url}>Volver a la ficha</a>
      <h1 class="lector-titulo">{m.titulo}</h1>
      <p class="lector-cuenta" aria-live="polite" data-cuenta>{total} páginas</p>
    </header>

    <main class="lector-escenario" data-lector data-total={total}>
      <ol class="lector-paginas">
        {
          paginas.map((p, i) => (
            <li class="lector-pagina" data-pagina={i + 1}>
              <img
                src={p.src}
                width={p.ancho}
                height={p.alto}
                alt={`Página ${i + 1} de ${total}`}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </li>
          ))
        }
      </ol>
      <button type="button" class="lector-zona lector-zona-izq" data-ir="-1" aria-label="Página anterior" hidden></button>
      <button type="button" class="lector-zona lector-zona-der" data-ir="1" aria-label="Página siguiente" hidden></button>
    </main>

    <nav class="lector-mandos" aria-label="Pasar páginas" data-mandos hidden>
      <button type="button" class="boton-sec" data-ir="-1">Anterior</button>
      <button type="button" class="boton-sec" data-ancho aria-pressed="false">Ajustar al ancho</button>
      <button type="button" class="boton" data-ir="1" data-siguiente>Siguiente</button>
    </nav>

    <script>
      const lector = document.querySelector<HTMLElement>('[data-lector]')!;
      const total = Number(lector.dataset.total);
      const paginas = [...lector.querySelectorAll<HTMLElement>('.lector-pagina')];
      const cuenta = document.querySelector<HTMLElement>('[data-cuenta]')!;
      const mandos = document.querySelector<HTMLElement>('[data-mandos]')!;
      const siguiente = mandos.querySelector<HTMLButtonElement>('[data-siguiente]')!;
      const ancho = mandos.querySelector<HTMLButtonElement>('[data-ancho]')!;
      const volver = document.querySelector<HTMLAnchorElement>('.lector-volver')!;
      const anterior = mandos.querySelector<HTMLButtonElement>('[data-ir="-1"]')!;

      document.body.classList.add('paginado');
      mandos.hidden = false;
      lector.querySelectorAll<HTMLButtonElement>('.lector-zona').forEach((z) => (z.hidden = false));

      const desdeHash = () => {
        const n = Number(location.hash.replace('#p-', ''));
        return Number.isInteger(n) && n >= 1 && n <= total ? n : 1;
      };
      let actual = desdeHash();

      const precargar = (n: number) => {
        const img = paginas[n - 1]?.querySelector('img');
        if (img) img.loading = 'eager';
      };

      const mostrar = (n: number, foco = false) => {
        actual = Math.min(Math.max(1, n), total);
        paginas.forEach((p, i) => (p.hidden = i + 1 !== actual));
        cuenta.textContent = `Página ${actual} de ${total}`;
        anterior.disabled = actual === 1;
        siguiente.textContent = actual === total ? 'Terminar' : 'Siguiente';
        precargar(actual + 1);
        precargar(actual - 1);
        history.replaceState(null, '', `#p-${actual}`);
        if (foco) lector.scrollTo({ top: 0 });
        window.scrollTo({ top: 0 });
      };

      const ir = (paso: number) => {
        if (paso > 0 && actual === total) {
          location.href = volver.href;
          return;
        }
        mostrar(actual + paso, true);
      };

      document.querySelectorAll<HTMLButtonElement>('[data-ir]').forEach((b) =>
        b.addEventListener('click', () => ir(Number(b.dataset.ir))),
      );
      ancho.addEventListener('click', () => {
        const on = ancho.getAttribute('aria-pressed') !== 'true';
        ancho.setAttribute('aria-pressed', String(on));
        document.body.classList.toggle('al-ancho', on);
      });
      document.addEventListener('keydown', (e) => {
        if (e.target instanceof HTMLInputElement || e.altKey || e.ctrlKey || e.metaKey) return;
        if (e.key === 'ArrowRight' || e.key === 'PageDown') ir(1);
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') ir(-1);
      });

      // Deslizar con el dedo
      let x0: number | null = null;
      let y0 = 0;
      lector.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch') {
          x0 = e.clientX;
          y0 = e.clientY;
        }
      });
      lector.addEventListener('pointerup', (e) => {
        if (x0 === null) return;
        const dx = e.clientX - x0;
        const dy = e.clientY - y0;
        x0 = null;
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) ir(dx < 0 ? 1 : -1);
      });

      mostrar(actual);
    </script>
  </body>
</html>
