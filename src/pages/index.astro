---
import { Image } from 'astro:assets';
import Archivador from '../layouts/Archivador.astro';
import Miniatura from '../components/Miniatura.astro';
import Cajon from '../components/Cajon.astro';
import { aventuras, ultimos, catalogo } from '../lib/catalogo';
import { TIPOS, AREAS } from '../data/areas';
import { SITIO } from '../data/sitio';
import { ruta } from '../lib/rutas';
import { cajaDe } from '../lib/cajas';

const cajas = await aventuras();
const nuevos = await ultimos(4);
const { materiales } = await catalogo();
const total = materiales.length;
// por la tablet del cajón pasan los últimos juegos sueltos
const pantalla = [...materiales].filter((m) => m.tipo === 'juego' && !m.aventura && !cajas.some((c) => c.mapa.id === m.id)).sort((a, b) => b.fecha.getTime() - a.fecha.getTime()).slice(0, 4);

// por área, sus 4 últimos materiales sueltos (los juegos de una aventura van dentro de su caja)
const porArea = AREAS.map((area) => {
  const suyos = materiales.filter((m) => m.tema.area.id === area.id);
  const vista = suyos.filter((m) => !m.aventura && !cajas.some((c) => c.mapa.id === m.id) && !nuevos.includes(m)).sort((a, b) => b.fecha.getTime() - a.fecha.getTime() || a.orden - b.orden).slice(0, 2);
  return { area, total: suyos.length, vista };
}).filter((x) => x.total > 0);
const fecha = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });
---

<Archivador activo="todo">
  <header class="cabecera">
    <h1 class="rotulo">{SITIO.nombre}</h1>
    <div class="presentacion">
      <p>{SITIO.presentacion}</p>
      <p class="firma">{SITIO.firma}</p>
    </div>
  </header>

  <Cajon total={total} pantalla={pantalla} />

  <section class="nuevo" aria-labelledby="nuevo-titulo">
    <h2 class="seccion-titulo" id="nuevo-titulo">Lo último que he metido</h2>
    <ul class="nuevo-lista">
      {
        nuevos.map((m) => (
          <li>
            <a class="nuevo-item" href={m.url} style={`--area: ${m.tema.area.color}`}>
              <Miniatura material={m} ancho={220} />
              <span class="nuevo-texto">
                <span class="nuevo-fecha">{fecha(m.fecha)} · {TIPOS[m.tipo].nombre.toLowerCase()}</span>
                <span class="material-titulo">{m.titulo}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    cajas.length > 0 && (
      <section class="aventuras" aria-labelledby="aventuras-titulo">
        <h2 class="seccion-titulo" id="aventuras-titulo">Aventuras</h2>
        <p class="aventuras-intro">Cajas con un montón de juegos dentro y un mapa para recorrerlos. Cada juego se puede jugar suelto.</p>
        <ul class="aventuras-lista">
          {cajas.map((a) => (
            <li>
              <a class="aventura" href={a.mapa.url} style={`--area: ${a.mapa.tema.area.color}`}>
                <span class="caja caja-grande">
                  <span class="miniatura forma-juego tapa">
                    {cajaDe(a.mapa.id) ? (
                      <img class="color" src={cajaDe(a.mapa.id)!.tapa} alt="" loading="lazy" />
                    ) : (
                      a.mapa.portada && <Image class="color" src={a.mapa.portada} alt="" widths={[480, 960]} sizes="(max-width: 860px) 92vw, 480px" />
                    )}
                    <span class="precinto">{a.juegos.length} juegos</span>
                    {Date.now() - a.mapa.fecha.getTime() < 21 * 864e5 && <span class="sello-nueva">Nueva</span>}
                  </span>
                </span>
                <span class="aventura-texto">
                  <span class="subrayado" style={`background: ${a.mapa.tema.area.color}`}>{a.mapa.tema.area.nombre}</span>
                  <span class="aventura-titulo">{a.mapa.titulo}</span>
                  <span class="material-meta">{a.zonas.length} zonas: {a.zonas.map((z) => z.nombre).join(', ')}.</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="por-areas" aria-labelledby="areas-titulo">
    <h2 class="seccion-titulo todo-titulo" id="areas-titulo">Por áreas</h2>
    <div class="areas-rejilla">
    {
      porArea.map(({ area, total, vista }) => (
        <section class="fila-area" style={`--area: ${area.color}`} aria-labelledby={`a-${area.id}`}>
          <div class="fila-area-cabeza">
            <h3 class="fila-area-titulo" id={`a-${area.id}`}>
              <span class="subrayado" style={`background: ${area.color}`}>{area.nombre}</span>
            </h3>
            <a class="ver-todo" href={ruta(`/${area.id}/`)}>
              Ver todo ({total})
            </a>
          </div>
          <ul class="nuevo-lista dos">
            {vista.map((m) => (
              <li>
                <a class="nuevo-item" href={m.url} style={`--area: ${area.color}`}>
                  <Miniatura material={m} ancho={220} />
                  <span class="nuevo-texto">
                    <span class="nuevo-fecha">{TIPOS[m.tipo].nombre}</span>
                    <span class="material-titulo">{m.titulo}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    </div>
    <p class="todo-enlace">
      <a class="boton" href={ruta('/todo/')}>Todo el cajón, con buscador ({total})</a>
    </p>
  </section>
</Archivador>

<script>
  // enlaces antiguos del tipo /?tipo=juego: al catálogo completo
  const q = new URLSearchParams(location.search);
  if (q.has('tipo') || q.has('q')) location.replace(new URL('todo/' + location.search, document.baseURI));
</script>
