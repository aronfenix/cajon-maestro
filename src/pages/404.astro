---
import Archivador from '../layouts/Archivador.astro';
import { ruta } from '../lib/rutas';
---

<Archivador activo="" titulo="No está">
  <header class="cabecera-area">
    <h1 class="rotulo">Esto no está en el cajón</h1>
  </header>
  <p class="vacio">
    La dirección no lleva a ningún material. Puede que lo haya cambiado de sitio. <a href={ruta('/')}>Vuelve a la portada</a> y
    búscalo por área o con el buscador.
  </p>
</Archivador>
